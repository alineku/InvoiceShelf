# Domain the app is served on, without https:// (point its DNS A record at the server first).
DOMAIN=sales.example.com
APP_NAME=Miras

# Generate once and keep it: docker run --rm php:8.4-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=

# Database passwords: any long random strings.
DB_PASSWORD=
DB_ROOT_PASSWORD=
